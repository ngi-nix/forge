# serializer version: 1
# name: test_snapshot_update[basic][recipe-basic]
  '''
  {
    lib,
    pkgs,
    ...
  }:
  
  {
    pkgs.basic = {
      version = "9.9.9";
      description = "Minimal forge-host recipe used by the snapshot tests.";
      homePage = "https://github.com/example/basic";
      mainProgram = "basic";
      license = lib.licenses.mit;
  
      source = {
        git = "github:example/basic/v9.9.9";
        hash = "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=";
      };
  
      build.builders.standard = {
        enable = true;
        packages.build = [ pkgs.pkg-config ];
      };
  
      test.script = ''
        basic --version
      '';
    };
  }
  
  '''
