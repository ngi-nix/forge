        hash = "sha256-IIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIII=";
      };
      build.builders.standard = {
        enable = true;
      };
    };
  
    pkgs.b = {
      version = "4.5.6";
      description = "Second package: must be left untouched.";
      source = {
        git = "github:example/b/v4.5.6";
        hash = "sha256-JJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJ=";
      };
      build.builders.standard = {
        enable = true;
      };
    };
  }
  
  '''
# ---
# name: test_snapshot_update[nested][recipe-nested]
  '''
  {
    lib,
    pkgs,
    ...
  }:
  
  {
    pkgs.nested = {
      version = "9.9.9";
      description = "Recipe with nested builder config and a version literal in scripts.";
      homePage = "https://github.com/example/nested";
      license = lib.licenses.gpl3Only;
  
      source = {
        git = "github:example/nested/v9.9.9";
        hash = "sha256-HHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHH=";
      };
  
      build.builders.standard = {
        enable = true;
        packages.build = [
          pkgs.cmake
          pkgs.ninja
          pkgs.pkg-config
        ];
      };
  
      build.extraAttrs = {
        postPatch = ''
          substituteInPlace meson.build \
            --replace-fail "version = \"1.2.3\"" "version = \"${version}\""
        '';
  
        cmakeFlags = [
          (lib.cmakeBool "ENABLE_TESTS" true)
        ];
      };
  
      build.phases = {
        check.enable = true;
      };
  
      test.script = ''
        echo 'version = "1.2.3"'
        nested --version
      '';
    };
  }
  
  '''
# ---
# name: test_snapshot_update[rust][recipe-rust]
  '''
  {
    lib,
    pkgs,
    ...
  }:
  
  {
    pkgs.rust-demo = {
      version = "9.9.9";
      description = "Rust recipe with a cargoHash pinned by the snapshot test.";
      homePage = "https://github.com/example/rust-demo";
      mainProgram = "rust-demo";
      license = lib.licenses.asl20;
  
      source = {
        git = "github:example/rust-demo/v9.9.9";
        hash = "sha256-DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD=";
      };
  
      build.builders.rust = {
        enable = true;
        cargoHash = "sha256-EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE=";
        packages.build = [ pkgs.pkg-config ];
        packages.run = [ pkgs.openssl ];
      };
  
      build.extraAttrs = {
        doCheck = false;
      };
    };
  }
  
  '''
# ---
# name: test_snapshot_update[self-ref][recipe-self_ref]
  '''
  {
    pkgs,
    config,
    ...
  }:
  let
    recipe = config.pkgs.self-ref;
  in
  {
    pkgs.self-ref = {
      version = "9.9.9";
      description = "Recipe whose git revision references its own version.";
      mainProgram = "self-ref";
  
      source = {
        git = "github:example/self-ref/v${recipe.version}";
        hash = "sha256-KKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKK=";
      };
  
      build.builders.standard = {
        enable = true;
      };
  
      test.script = ''
        self-ref --version | grep -q ${recipe.version}
      '';
    };
  }
  
  '''
